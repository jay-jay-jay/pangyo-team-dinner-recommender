# Kakao Developers (https://developers.kakao.com) -> 내 애플리케이션 -> 앱 키 -> REST API 키
KAKAO_KEY=your_kakao_rest_api_key_here

# Naver Developers (https://developers.naver.com) -> Application -> 내 애플리케이션 -> Client ID / Secret
NAVER_ID=your_naver_client_id_here
NAVER_SECRET=your_naver_client_secret_here
